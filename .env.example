# Copy this file to .env.development and/or .env.production and fill in real values.
# Never commit the filled-in env files — they are git-ignored.

VITE_APP_ENV=development

# From Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-public-key

# Notes:
# - .env.development  → used by `npm run dev`  (Vite development mode)
# - .env.production   → used by `npm run build` (Vite production mode)
# - Leave URL/KEY blank to run on the localStorage fallback (no cloud) — useful
#   for offline/local-only testing before Supabase is configured.
